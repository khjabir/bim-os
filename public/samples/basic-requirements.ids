<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>Basic information requirements</title>
    <description>A small starter set of requirements that most coordination models are expected to meet. Edit it or replace it with your project's IDS.</description>
    <author>ifc-studio@example.com</author>
    <version>1.0</version>
    <purpose>Coordination</purpose>
  </info>
  <specifications>
    <specification name="Storeys are named" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Every building storey needs a name so that elements can be filtered and scheduled by level.">
      <applicability minOccurs="1" maxOccurs="unbounded">
        <entity>
          <name>
            <simpleValue>IFCBUILDINGSTOREY</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required" instructions="Give each level a name such as 'Level 01'.">
          <name>
            <simpleValue>Name</simpleValue>
          </name>
        </attribute>
      </requirements>
    </specification>
    <specification name="Building elements are named" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Walls, slabs, beams, columns, doors and windows must carry a name.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCWALL"/>
              <xs:enumeration value="IFCWALLSTANDARDCASE"/>
              <xs:enumeration value="IFCSLAB"/>
              <xs:enumeration value="IFCBEAM"/>
              <xs:enumeration value="IFCCOLUMN"/>
              <xs:enumeration value="IFCDOOR"/>
              <xs:enumeration value="IFCWINDOW"/>
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name>
            <simpleValue>Name</simpleValue>
          </name>
        </attribute>
      </requirements>
    </specification>
    <specification name="Walls state whether they are external" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Pset_WallCommon.IsExternal drives envelope take-off and energy checks.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCWALL"/>
              <xs:enumeration value="IFCWALLSTANDARDCASE"/>
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="required" dataType="IFCBOOLEAN">
          <propertySet>
            <simpleValue>Pset_WallCommon</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>IsExternal</simpleValue>
          </baseName>
        </property>
      </requirements>
    </specification>
    <specification name="Walls state whether they are load bearing" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Pset_WallCommon.LoadBearing separates structural walls from partitions.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCWALL"/>
              <xs:enumeration value="IFCWALLSTANDARDCASE"/>
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="required" dataType="IFCBOOLEAN">
          <propertySet>
            <simpleValue>Pset_WallCommon</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>LoadBearing</simpleValue>
          </baseName>
        </property>
      </requirements>
    </specification>
    <specification name="Doors have a fire rating" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Pset_DoorCommon.FireRating must be filled in, even if the value is 'none'.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <simpleValue>IFCDOOR</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <property cardinality="required">
          <propertySet>
            <simpleValue>Pset_DoorCommon</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>FireRating</simpleValue>
          </baseName>
        </property>
      </requirements>
    </specification>
    <specification name="Spaces have a number and a description" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Name holds the room number, LongName the room description.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <simpleValue>IFCSPACE</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name>
            <simpleValue>Name</simpleValue>
          </name>
        </attribute>
        <attribute cardinality="required">
          <name>
            <simpleValue>LongName</simpleValue>
          </name>
        </attribute>
      </requirements>
    </specification>
    <specification name="Structural elements have a material" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Beams, columns, slabs and footings need a material for quantities by material.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name>
            <xs:restriction base="xs:string">
              <xs:enumeration value="IFCBEAM"/>
              <xs:enumeration value="IFCCOLUMN"/>
              <xs:enumeration value="IFCSLAB"/>
              <xs:enumeration value="IFCFOOTING"/>
            </xs:restriction>
          </name>
        </entity>
      </applicability>
      <requirements>
        <material cardinality="required"/>
      </requirements>
    </specification>
    <specification name="No generic proxy elements" ifcVersion="IFC2X3 IFC4 IFC4X3_ADD2" description="Elements exported as IfcBuildingElementProxy should be given a proper IFC class.">
      <applicability minOccurs="0" maxOccurs="0">
        <entity>
          <name>
            <simpleValue>IFCBUILDINGELEMENTPROXY</simpleValue>
          </name>
        </entity>
      </applicability>
    </specification>
  </specifications>
</ids>
