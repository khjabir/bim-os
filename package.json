{
  "name": "bim-os",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source BIM workbench in the browser: IFC viewer and analysis, Revit and Navisworks import, conversion to IFC, and COBie and asset registers for facilities management.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khjabir/bim-os.git"
  },
  "homepage": "https://github.com/khjabir/bim-os#readme",
  "bugs": {
    "url": "https://github.com/khjabir/bim-os/issues"
  },
  "keywords": [
    "bim",
    "ifc",
    "openbim",
    "revit",
    "navisworks",
    "cobie",
    "cafm",
    "facilities-management",
    "web-ifc",
    "thatopen",
    "nextjs"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "postinstall": "node scripts/copy-assets.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "convert": "node scripts/convert-ifc.mjs",
    "combine": "node scripts/combine-frags.mjs",
    "build:rvt-wasm": "bash scripts/build-rvt-wasm.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@thatopen/components": "3.6.0",
    "@thatopen/components-front": "3.6.1",
    "@thatopen/fragments": "3.6.1",
    "camera-controls": "^3.1.2",
    "clsx": "^2.1.1",
    "flatbuffers": "25.2.10",
    "lucide-react": "^1.71.0",
    "next": "^16.4.6",
    "pdfjs-dist": "6.4.299",
    "potree-core": "^2.0.15",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.184.0",
    "three-mesh-bvh": "0.9.9",
    "web-ifc": "0.0.77",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.184.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
